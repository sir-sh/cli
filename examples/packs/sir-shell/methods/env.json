{
  "method": "env",
  "description": "Get or set environment variable",
  "args": {
    "name": {
      "type": "string",
      "required": true,
      "description": "Variable name"
    },
    "value": {
      "type": "string",
      "required": false,
      "description": "Value to set (omit to get)"
    }
  },
  "returns": {
    "value": {
      "type": "string",
      "description": "Variable value"
    }
  },
  "effects": {
    "network": false,
    "writes": [],
    "interactive": false
  },
  "impl": {
    "type": "shell",
    "command": "{{#if value}}export {{name}}={{shellQuote value}}{{else}}echo ${{{name}}}{{/if}}"
  }
}